#include <winuser.h>
#include <winver.h>
1 ICON "tinydaw.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "tinydaw.manifest"

/* shows in the file's Properties > Details on Windows */
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJ, VER_MIN, VER_PAT, 0
PRODUCTVERSION VER_MAJ, VER_MIN, VER_PAT, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "tinydaw"
      VALUE "ProductName", "tinydaw"
      VALUE "FileVersion", VER_STR
      VALUE "ProductVersion", VER_STR
      VALUE "OriginalFilename", "tinydaw.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
